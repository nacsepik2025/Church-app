<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Church Service Report</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-6">
  <div class="bg-white p-8 rounded-2xl shadow-lg w-full max-w-2xl">
    <h1 class="text-2xl font-bold mb-6 text-center">Church Service Report</h1>
    <form id="reportForm" class="space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block font-medium">Date</label>
          <input type="date" name="date" required class="w-full border rounded p-2">
        </div>
        <div>
          <label class="block font-medium">Congregation</label>
          <input type="text" name="congregation" required class="w-full border rounded p-2">
        </div>
        <div>
          <label class="block font-medium">Sub District</label>
          <input type="text" name="subDistrict" required class="w-full border rounded p-2">
        </div>
        <div>
          <label class="block font-medium">District Rector</label>
          <input type="text" name="districtRector" required class="w-full border rounded p-2">
        </div>
        <div>
          <label class="block font-medium">Officiant</label>
          <input type="text" name="officiant" required class="w-full border rounded p-2">
        </div>
        <div>
          <label class="block font-medium">Assistants</label>
          <input type="text" name="assistants" class="w-full border rounded p-2">
        </div>
        <div>
          <label class="block font-medium">Offering (K)</label>
          <input type="number" name="offering" step="0.01" required class="w-full border rounded p-2">
        </div>
        <div>
          <label class="block font-medium">Attendance</label>
          <input type="number" name="attendance" required class="w-full border rounded p-2">
        </div>
        <div>
          <label class="block font-medium">Baptism</label>
          <input type="number" name="baptism" class="w-full border rounded p-2">
        </div>
        <div>
          <label class="block font-medium">Sunday School</label>
          <input type="number" name="sundaySchool" class="w-full border rounded p-2">
        </div>
        <div>
          <label class="block font-medium">Confirmands</label>
          <input type="number" name="confirmands" class="w-full border rounded p-2">
        </div>
      </div>
      <div>
        <label class="block font-medium">Remarks</label>
        <textarea name="remarks" rows="3" class="w-full border rounded p-2"></textarea>
      </div>
      <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">Submit</button>
      <p id="statusMessage" class="mt-4 text-green-600 hidden">Form submitted successfully!</p>
    </form>
  </div>

  <script>
    const form = document.getElementById('reportForm');
    const statusMessage = document.getElementById('statusMessage');

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // Simulate a submission for now
      statusMessage.classList.remove('hidden');
      form.reset();
    });
  </script>
</body>
</html>
